  {
    "block_id": "ZY3cdMNqgoCjNoxBEWQlM8gag4g",
    "block_type": 2,
    "parent_id": "doxlgbyEQqGKqyyhe7tTpO5hQtf",
    "text": {
      "elements": [
        {
          "text_run": {
            "content": "当前答题流程为「选择选项 → 点击 Submit 按钮 → 提交答案」，对于低龄用户而言存在一定的操作理解与执行成本。一方面，孩子在选择答案后容易忽略点击 Submit 按钮，导致答题流程中断或卡顿；另一方面，多一步确认操作降低了整体答题节奏，影响学习的流畅性与沉浸体验。",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
