              "bold": true,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        },
        {
          "text_run": {
            "content": "：47 天 → 落在 45 那一档 → 90%；55 天还是 90%；60 天才跳到 93%。\n（2）右侧：展示平台全球连胜前 100 名的用户，展示信息：头像、昵称、IP所在地国旗、连胜天数。\n",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        },
        {
          "text_run": {
            "content": "榜单更新规则：用户完成学习后再进入，实时刷新排名。",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        }
      ],
      "style": {
        "align": 1,
        "folded": false
      }
    }
  },
