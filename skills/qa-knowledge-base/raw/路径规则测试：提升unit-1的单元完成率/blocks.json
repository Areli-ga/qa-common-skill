    "ordered": {
      "elements": [
        {
          "text_run": {
            "content": "Unit之间的衔接率高，unit内部流失大：",
            "text_element_style": {
              "bold": true,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        },
        {
          "text_run": {
            "content": "\n",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        },
        {
          "text_run": {
            "content": "新用户每天约 9,644 人开始 U1，只有 4,150 人学完（43%）。学完一个 unit 的孩子几乎都会马上开始下一个（U2–U8 衔接率 91%–103%），流失发生在 unit 内部的约 4 节课之间。",
            "text_element_style": {
              "bold": false,
              "inline_code": false,
              "italic": false,
              "strikethrough": false,
              "underline": false
            }
          }
        }
      ],
      "style": {
        "align": 1,
        "folded": false,
        "sequence": "1"
      }
    },
    "parent_id": "Szi5dCXXqohexix39GAlf42xgAc"
